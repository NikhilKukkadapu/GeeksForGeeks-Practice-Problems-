class Solution {
	public String findRollOut(String s, int[] roll) {
		// code here
		int n = s.length();
		int m = roll.length;
		
		int[] diff = new int[n + 1];
		
		for (int i = 0; i < m; i++) {
			diff[0] += 1;
			
			if (roll[i] < n) {
				diff[roll[i]] -= 1;
			}
		}
		
		for (int i = 1; i < n; i++) {
			diff[i] += diff[i - 1];
		}
		
		StringBuilder sb = new StringBuilder(s);
		
		for (int i = 0; i < n; i++) {
			
			int shift = diff[i] % 26;
			
			char c = (char)('a'+ (sb.charAt(i) - 'a' + shift) % 26);
			
			sb.setCharAt(i, c);
		}
		
		return sb.toString();
	}
}

