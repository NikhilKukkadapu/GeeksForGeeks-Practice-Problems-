class Solution {
    public long findIndex(String str) {
        long closeCount = 0;
        
        // Count the total number of closing brackets
        for (int i = 0; i < str.length(); i++) {
            if (str.charAt(i) == ')') {
                closeCount++;
            }
        }
        
        // The index is equal to the total count of closing brackets
        return closeCount;
    }
}
