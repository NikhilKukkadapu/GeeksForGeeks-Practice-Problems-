class Solution {
    public boolean canSeatAllPeople(int k, int[] seats) {
        // code here
        int n = seats.length;

        // Check if the existing arrangement is already invalid
        for (int i = 0; i < n - 1; i++) {
            if (seats[i] == 1 && seats[i + 1] == 1) {
                return false;
            }
        }

        int count = 0;

        // Greedily place people wherever possible
        for (int i = 0; i < n; i++) {
            if (seats[i] == 0) {
                boolean leftEmpty = (i == 0) || (seats[i - 1] == 0);
                boolean rightEmpty = (i == n - 1) || (seats[i + 1] == 0);

                if (leftEmpty && rightEmpty) {
                    seats[i] = 1; // place a person
                    count++;

                    if (count >= k) {
                        return true;
                    }
                }
            }
        }

        return count >= k;
    }
}
