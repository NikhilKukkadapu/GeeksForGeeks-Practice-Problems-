class Solution {
	public int minSubarraySum(int[] arr) {
		// code here
		int n = arr.length;
		int sum = Integer.MAX_VALUE;
		int minsum = Integer.MAX_VALUE;
		for (int i = 0 ; i < n ; i++) {
			if (sum > 0) {
				sum = arr[i];
			}
			else {
				sum += arr[i];
			}
			minsum = Math.min(sum, minsum);
		}
		return minsum;
	}
}
