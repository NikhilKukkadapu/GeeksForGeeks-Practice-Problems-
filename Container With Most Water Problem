class Solution {
    public int maxWater(int arr[]) {
        // Code Here
        int n = arr.length ;
        int left = 0 ; 
        int right = n - 1;
        int maxarea = 0;
        while(left <= right ){
            int h = Math.min(arr[left] , arr[right]);
            int w = right- left;
            int area = h * w;
            maxarea = Math.max(maxarea , area );
            if(arr[left] <= arr[right] ){
                left++;
            }
            else{
                right--;
            }
        }
        return maxarea;
    }
}
