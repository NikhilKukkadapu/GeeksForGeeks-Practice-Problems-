class Solution {

    public long firstIndex(int arr[]) {
        // Your code goes here
        int low = 0;
        int high = arr.length - 1;
        long ans = -1;
        
        while (low <= high) {
            int mid = low + (high - low) / 2;
            
            if (arr[mid] == 1) {
                ans = mid;         // Record the index
                high = mid - 1;    // Search for a potentially earlier '1' on the left
            } else {
                low = mid + 1;     // Move to the right to find '1'
            }
        }
        
        return ans;
    }
}
