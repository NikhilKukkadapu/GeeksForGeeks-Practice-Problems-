class Solution {
    public int maxDistance(int[] arr) {
        // Code here
        int res = 0;
        HashMap<Integer , Integer> map = new HashMap<>();
        for(int i = 0 ; i< arr.length; i++){
            if(!map.containsKey(arr[i])){
                map.put(arr[i],i);
            }
            else{
                res = Math.max(res, i - map.get(arr[i]));
            }
        }
        return res;
    }
}
