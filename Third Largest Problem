class Solution {
	public int thirdLargest(List<Integer> arr) {
		// code here
		int n = arr.size();
		
		
		if (n < 3)
			return - 1;
		
		
		int first = -1;
		int second = -1;
		int third = -1;
		
		for (int num : arr) {
			
			if (num >= first) {
				third = second;
				second = first;
				first = num;
				
			} else if (num >= second) {
				third = second;
				second = num;
				
			} else if (num >= third) {
				third = num;
			}
		}
		
		
		return third;
	}
}
